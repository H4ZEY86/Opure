<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:contracts="clr-namespace:Opure.Desktop.Contracts;assembly=Opure.Desktop.Contracts"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Opure.Desktop.RecoveryPointView"
             x:DataType="contracts:DesktopRecoveryPointViewModel"
             x:Name="RootControl">
    <StackPanel Spacing="12">
        <TextBlock
            Text="Local recovery points"
            FontSize="20"
            FontWeight="SemiBold"
            AutomationProperties.HeadingLevel="2" />

        <Border BorderThickness="2" CornerRadius="4" Padding="12">
            <StackPanel Spacing="4">
                <TextBlock
                    x:Name="RecoveryPointScopeWarning"
                    Text="Same-device recovery only"
                    FontWeight="Bold"
                    AutomationProperties.Name="Warning. Same-device recovery only." />
                <TextBlock
                    Text="These points support local rollback. They do not protect against device loss, disk failure or destructive malware."
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel Spacing="4">
            <TextBlock Text="{Binding StatusTitle}" FontWeight="SemiBold" AutomationProperties.Name="{Binding StatusTitle}" AutomationProperties.AutomationId="RecoveryPointStatusTitle" />
            <TextBlock Text="{Binding StatusDetail}" TextWrapping="Wrap" AutomationProperties.Name="{Binding StatusDetail}" AutomationProperties.AutomationId="RecoveryPointStatusDetail" />
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" AutomationProperties.Name="Recovery point operation in progress. Closing the window cancels the operation." AutomationProperties.AutomationId="RecoveryPointProgress" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
                x:Name="CreateRecoveryPointButton"
                Content="_Create recovery point"
                Command="{Binding CreateRecoveryPointCommand}"
                IsTabStop="True"
                TabIndex="9"
                AutomationProperties.Name="Create local recovery point"
                AutomationProperties.AutomationId="CreateRecoveryPoint"
                AutomationProperties.AccessKey="Alt+C" />
            <Button
                x:Name="RefreshRecoveryPointsButton"
                Content="Re_fresh list"
                Command="{Binding RefreshRecoveryPointsCommand}"
                IsTabStop="True"
                TabIndex="10"
                AutomationProperties.Name="Refresh local recovery points"
                AutomationProperties.AutomationId="RefreshRecoveryPoints"
                AutomationProperties.AccessKey="Alt+F" />
        </StackPanel>

        <ListBox
            x:Name="RecoveryPointList"
            ItemsSource="{Binding RecoveryPoints}"
            SelectionMode="Single"
            IsTabStop="True"
            TabIndex="11"
            AutomationProperties.Name="Local recovery points. Use arrow keys to inspect a recovery point."
            AutomationProperties.AutomationId="RecoveryPointList">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="contracts:DesktopRecoveryPoint">
                    <Border
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10"
                        Margin="0,0,0,8"
                        AutomationProperties.Name="{Binding AccessibilityLabel}">
                        <StackPanel>
                            <TextBlock Text="{Binding RecoveryPointId, StringFormat='ID: {0}'}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CreatedAt, StringFormat='Created: {0:g}'}"/>
                            <TextBlock Text="{Binding VerificationState, StringFormat='Structural verification: {0}'}"/>
                            <TextBlock Text="{Binding ProductVersion, StringFormat='Product version: {0}'}"/>
                            <TextBlock Text="{Binding OwnerCount, StringFormat='Required owners: {0} complete'}"/>
                            <TextBlock Text="{Binding SchemaSummary, StringFormat='Schema versions: {0}'}"/>
                            <TextBlock Text="Creation and verification receipts" FontWeight="SemiBold" Margin="0,5,0,0"/>
                            <ItemsControl ItemsSource="{Binding Receipts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="contracts:DesktopRecoveryPointReceipt">
                                        <TextBlock
                                            Text="{Binding EventType, StringFormat='{}{0}'}"
                                            AutomationProperties.Name="{Binding StatusMessage}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button
                                Content="_Verify in disposable staging"
                                Command="{Binding #RootControl.((contracts:DesktopRecoveryPointViewModel)DataContext).VerifyRecoveryPointCommand}"
                                CommandParameter="{Binding}"
                                Margin="0,5,0,0"
                                HorizontalAlignment="Left"
                                IsTabStop="True"
                                TabIndex="12"
                                AutomationProperties.Name="Verify this recovery point without touching the active data root"
                                AutomationProperties.AutomationId="VerifyRecoveryPoint" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</UserControl>
