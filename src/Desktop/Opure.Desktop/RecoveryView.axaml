<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:contracts="clr-namespace:Opure.Desktop.Contracts;assembly=Opure.Desktop.Contracts"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Opure.Desktop.RecoveryView"
             x:DataType="contracts:DesktopRecoveryViewModel"
             x:Name="RootControl">
    <Border
        BorderThickness="2"
        CornerRadius="8"
        Padding="24"
        Margin="32"
        MaxWidth="800">
        <Border.Styles>
            <Style Selector="Border">
                <Setter Property="Background" Value="{DynamicResource SystemRegionBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumHighBrush}" />
            </Style>
        </Border.Styles>
        <StackPanel Spacing="12">
        <StackPanel Spacing="4">
            <TextBlock Text="Actionable forensic recoveries" FontWeight="SemiBold" FontSize="18" AutomationProperties.HeadingLevel="2" />
            <TextBlock Text="These are unresolved post-commit failures. The actual hash differs from the expected hash. You must resolve these anomalies manually." TextWrapping="Wrap" />
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRefreshing}" AutomationProperties.Name="Refreshing recovery audits." />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
                Content="Re_fresh audits"
                Command="{Binding RefreshCommand}"
                IsTabStop="True"
                TabIndex="10"
                AutomationProperties.Name="Refresh forensic recovery audits"
                AutomationProperties.AutomationId="RefreshRecoveryAudits"
                AutomationProperties.AccessKey="Alt+F" />
        </StackPanel>

        <ListBox
            ItemsSource="{Binding Audits}"
            SelectionMode="Single"
            IsTabStop="True"
            TabIndex="11"
            AutomationProperties.Name="Recovery audits. Use arrow keys to inspect."
            AutomationProperties.AutomationId="RecoveryAuditList">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="contracts:DesktopRecoveryAudit">
                    <Border
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10"
                        Margin="0,0,0,8"
                        AutomationProperties.Name="{Binding AccessibilityLabel}">
                        <StackPanel>
                            <TextBlock Text="{Binding PatchId, StringFormat='Patch ID: {0}'}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Timestamp, StringFormat='Timestamp: {0}'}"/>
                            <TextBlock Text="{Binding ApproverIdentity, StringFormat='Approver: {0}'}"/>
                            <TextBlock Text="{Binding ExpectedHash, StringFormat='Expected Hash: {0}'}"/>
                            <TextBlock Text="{Binding ActualHash, StringFormat='Actual Hash: {0}'}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Button
                                    Content="_Restore snapshot"
                                    Command="{ReflectionBinding $parent[UserControl].DataContext.RestoreCommand}"
                                    CommandParameter="{Binding}"
                                    IsTabStop="True"
                                    TabIndex="12"
                                    AutomationProperties.Name="Restore the original staging snapshot for this patch."
                                    AutomationProperties.AutomationId="RestoreSnapshotButton" />
                                <Button
                                    Content="_Discard snapshot"
                                    Command="{ReflectionBinding $parent[UserControl].DataContext.DiscardCommand}"
                                    CommandParameter="{Binding}"
                                    IsTabStop="True"
                                    TabIndex="13"
                                    AutomationProperties.Name="Discard the staging snapshot for this patch."
                                    AutomationProperties.AutomationId="DiscardSnapshotButton" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
    </Border>
</UserControl>
