<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Opure.Desktop.Contracts"
             xmlns:conv="using:Opure.Desktop.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Opure.Desktop.Views.McpCommandCenterView"
             x:DataType="vm:DesktopMcpCommandCenterViewModel">
             
  <UserControl.Resources>
    <conv:CapabilityColorConverter x:Key="CapabilityColorConverter" />
  </UserControl.Resources>

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="16" Margin="0,0,0,16">
      <Button Content="Refresh Tools" 
              Command="{Binding RefreshAsync}" 
              Padding="12,8"
              Background="#2D2D2D" Foreground="White" BorderBrush="#555" BorderThickness="1"
              CornerRadius="0" />
      
      <TextBlock Text="Loading..." VerticalAlignment="Center" Foreground="#888"
                 IsVisible="{Binding IsRefreshing}"/>
                 
      <TextBlock Text="{Binding ErrorMessage}" VerticalAlignment="Center" Foreground="#FF003C"
                 IsVisible="{Binding HasError}"/>
    </StackPanel>

    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Tools}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="#333" BorderThickness="1" Margin="0,0,0,16" Padding="16" Background="#1A1A1A">
              <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                  <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" Foreground="#E0E0E0" Margin="0,0,0,4"/>
                  <TextBlock Text="{Binding Description}" Foreground="#A0A0A0" TextWrapping="Wrap"/>
                </StackPanel>

                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding GrantedCapabilities}" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="8"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <!-- Brutalist capability tags -->
                      <Border BorderBrush="{Binding Converter={StaticResource CapabilityColorConverter}}" 
                              BorderThickness="1" Padding="6,2" CornerRadius="0">
                        <TextBlock Text="{Binding}" FontSize="12" Foreground="{Binding Converter={StaticResource CapabilityColorConverter}}" FontWeight="Bold" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
